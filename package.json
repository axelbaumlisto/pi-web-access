{
  "name": "pi-ext-int-search",
  "version": "1.3.0",
  "description": "Hardened fork of nicobailon/pi-web-access (synced to v0.28.0) with unified proxy mode + destination-first key binding + added internal search. EXTERNAL: web_search across OpenAI, Brave, Parallel, TinyFish, Search1API, Searchinfinity, Querit, Tavily, Firecrawl, Jina, SERPdive, Kagi, Ollama, AnySearch, Bright Data, SerpBase, SearXNG, Exa, Perplexity, Gemini, Kimi, Mistral (URL fetch raw/answer modes, GitHub clone + PR/issue, PDF, YouTube/video, source_check). INTERNAL: memory_search over your own pi chat sessions, claude-recall memories, project docs, and git history.",
  "type": "module",
  "scripts": {
    "test": "node --import ./test/hermetic-env.mjs --test",
    "typecheck": "tsc",
    "audit:runtime": "npm audit --omit=dev --omit=peer"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "web-search",
    "memory-search",
    "internal-search",
    "external-search",
    "tinyfish",
    "search1api",
    "searchinfinity",
    "querit",
    "perplexity",
    "exa",
    "gemini",
    "fetch",
    "scraping"
  ],
  "author": "Nico Bailon (original), axelbaumlisto (ext+int fork)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelbaumlisto/pi-web-access.git"
  },
  "bugs": {
    "url": "https://github.com/axelbaumlisto/pi-web-access/issues"
  },
  "homepage": "https://github.com/axelbaumlisto/pi-web-access#readme",
  "files": [
