{
	"name": "pi-ext-int-search",
	"version": "1.6.3",
	"description": "Hardened fork of nicobailon/pi-web-access (synced to v0.37.0) with unified proxy mode + destination-first credential gating, redacted errors, and memory_search over local history.",
	"type": "module",
	"bin": {
		"pi-web-access-mcp": "dist/mcp-cli.js"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --import ./test/hermetic-env.mjs --test",
		"typecheck": "tsc",
		"audit:runtime": "npm audit --omit=dev --omit=peer",
		"build": "node scripts/build.js",
		"prepublishOnly": "npm run build && node scripts/pi-extensions-dist.js dist",
		"postpublish": "node scripts/pi-extensions-dist.js index.ts",
		"release": "node scripts/publish.js"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"web-search",
		"memory-search",
		"internal-search",
		"external-search",
		"tinyfish",
		"search1api",
		"searchinfinity",
		"querit",
		"perplexity",
		"exa",
		"gemini",
		"fetch",
		"scraping"
	],
	"author": "Nico Bailon (original), axelbaumlisto (ext+int fork)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/axelbaumlisto/pi-web-access.git"
	},
	"bugs": {
		"url": "https://github.com/axelbaumlisto/pi-web-access/issues"
	},
	"homepage": "https://github.com/axelbaumlisto/pi-web-access#readme",
	"files": [
		"dist",
		"*.ts",
		"CHANGELOG.md",
		"SECURITY.md",
		"banner.png",
		"pi-web-fetch-demo.mp4",
		"skills"
	],
	"devDependencies": {
		"@earendil-works/pi-ai": "1.0.4",
		"@earendil-works/pi-coding-agent": "1.0.4",
		"@earendil-works/pi-tui": "1.0.4",
		"@types/turndown": "^5.0.6",
		"esbuild": "^0.28.1",
		"typebox": "1.3.27",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.1",
		"@mozilla/readability": "^0.6.0",
		"defuddle": "0.19.3",
		"linkedom": "^0.16.0",
		"p-limit": "^6.1.0",
		"promise.try": "^2.0.1",
		"turndown": "^7.2.0",
		"undici": "^8.11.2",
		"unpdf": "^1.6.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"video": "https://github.com/axelbaumlisto/pi-web-access/raw/refs/heads/main/pi-web-fetch-demo.mp4",
		"skills": [
			"./skills"
		]
	}
}
